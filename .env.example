# Local PostgreSQL only. Keep these values in sync with DATABASE_URL.
POSTGRES_USER=cds
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=cds_ecommerce
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cds:replace-with-local-password@localhost:5433/cds_ecommerce

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100

# Existing development S3 bucket. Credentials remain in your local AWS profile.
AWS_REGION=us-east-2
S3_BUCKET_NAME=cds-challenge-german-647432778236
AWS_PROFILE=cds-challenge

# Stripe test environment only. Configure after creating your Stripe account.
# Keep both values server-side; never use NEXT_PUBLIC_ for these secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
