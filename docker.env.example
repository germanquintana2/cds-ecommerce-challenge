# Required: private S3 bucket and AWS session authenticated inside Docker.
AWS_REGION=us-east-2
S3_BUCKET_NAME=
AWS_PROFILE=cds-challenge

# Stripe secret key from a sandbox; never use a live key.
STRIPE_SECRET_KEY=

# All local passwords and auth secrets are generated and persisted automatically.
# Optional: choose the initial administrator email before the first launch.
ADMIN_EMAIL=admin@example.com
